{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "triggers": {
    "crons": ["17 0 * * *", "*/15 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://lizuju.github.io,http://127.0.0.1:3090,http://localhost:3090",
    "CF_ACCOUNT_ID": "0be0dce5142b529358029d497d38de65"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING_REGISTRY", "class_name": "PairingRegistry" },
      { "name": "SYNC_ROOMS", "class_name": "SyncRoom" },
      { "name": "FILE_SHARDS", "class_name": "FileShard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingRegistry", "SyncRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["FileShard"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "invocation_logs": false }
  }
}
